
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

AGENT_HQ_MONTHLY_BUDGET_USD=5
AGENT_HQ_MAX_TASK_COST_USD=0.10
AGENT_HQ_MAX_MODEL_CALLS_PER_TASK=6
AGENT_HQ_MAX_CONCURRENT_RUNS=1
AGENT_HQ_AUTONOMOUS_RUNS_ENABLED=false
AGENT_HQ_MODEL_TIMEOUT_MS=30000
AGENT_HQ_MAX_OUTPUT_TOKENS=1200

# Single-process local persistence; never delete to reset a spending limit.
AGENT_HQ_DATA_DIR=data
